# Copy to .env and fill in. Never commit .env.

# ---- The media-stream server ----
PORT=5050
# The PUBLIC host Twilio's <Stream> connects back to (no scheme). The app builds
# wss://<PUBLIC_HOST>/media-stream from it.
#   VPS (production): the VPS IP in sslip.io form, fronted by Caddy for TLS.
#     e.g. PUBLIC_HOST=31-97-214-59.sslip.io   (IP 31.97.214.59)
#   Quick local test: an ngrok tunnel host, e.g. PUBLIC_HOST=abc123.ngrok-free.app
PUBLIC_HOST=31-97-214-59.sslip.io

# ---- Shared backend tools (the SAME service the Retell agent uses) ----
# check availability, book, callback, mark outcome. No trailing slash.
#   Deployed: https://voice-agent-backend-cyan.vercel.app
BACKEND_URL=
# Must match the backend's AGENT_TOOLS_SECRET (sent as the x-agent-secret header).
AGENT_TOOLS_SECRET=

# ---- OpenAI Realtime ----
OPENAI_API_KEY=
# Realtime model. Two good options:
#   gpt-realtime-2.1       — higher capability: best alphanumeric read-back (times, phone, codes),
#                            noise/silence handling, interruptions, and lowest latency.
#   gpt-realtime-2.1-mini  — cheaper and faster, with reasoning + tool use at the mini price.
# Switch to A/B them; the app just uses whatever you set here.
OPENAI_MODEL=gpt-realtime-2.1
# Voice for the agent. gpt-realtime voices include natural ones like "marin" and "cedar";
# "alloy" always works.
OPENAI_VOICE=alloy

# ---- Twilio (telephony) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number to call FROM (E.164, e.g. +14255551234).
TWILIO_FROM_NUMBER=

# ---- Webhook / stream authentication ----
# Verify Twilio's X-Twilio-Signature on the inbound webhooks. Default false so that turning it on
# is a deliberate step: the signature is computed over the URL as TWILIO built it, so if PUBLIC_HOST
# does not exactly match the URL configured in the Twilio console, EVERY real call is rejected.
# Turn it on, place one test call, confirm it connects, then leave it on.
# (/incoming-fallback is never verified — it is the last line of defence and only dials a number
# from this file, so it must keep working even when the signature check is misconfigured.)
VALIDATE_TWILIO_SIGNATURE=false
# Shared secret appended to the media-stream WebSocket path, e.g. wss://host/media-stream/<secret>.
# WebSockets carry no Twilio signature, so without this anyone who can reach the server can open an
# OpenAI Realtime session on your API key (~$0.30/min). Any long random string; blank = no secret.
#   generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
STREAM_SECRET=

# ---- Inbound call screening (optional) ----
# Leave the whole block unset to run outbound-only, exactly as before. These only take effect on
# calls that arrive through the /incoming webhook.
#
# The colleague a booking request is warm-transferred to (E.164). Without it the agent still
# answers and takes messages, but can never hand a caller to a person.
HUMAN_TRANSFER_NUMBER=
# The client's public main line (E.164). Used as the transfer's caller ID, so the handoff reaches
# the colleague as a number they recognize rather than an unknown, spam-scored one. Falls back to
# TWILIO_FROM_NUMBER if unset.
MAIN_LINE_NUMBER=
# How the agent introduces the company and itself when it answers.
BUSINESS_NAME=TecAce
AGENT_NAME=Tess
BUSINESS_HOURS=Monday to Friday, 9 AM to 6 PM Pacific
# Whether we're open is stated in the prompt so the agent can warn before transferring after hours.
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
# Optional: REPLACES the spoken facts the agent may answer from (realtime/faq.py), so the same app
# can answer for a different client without leaking TecAce's details into their calls. The FAQ
# guidance and the hard deferrals are company-agnostic and always apply. Blank = TecAce's facts.
BUSINESS_FACTS=
# Say "just so you know, this call is recorded" in the opening line. ON by default: the call
# transcript IS persisted, and Washington is a two-party-consent state. Turn off only on legal
# advice — the agent's answer to "is this recorded?" follows this setting either way.
DISCLOSE_RECORDING=true
# The inbound agent's opening line — it speaks FIRST, before the caller says anything.
# `{business}` and `{agent}` are substituted. Keep it to one breath and end with an OPEN question:
# the agent does not know who is calling, so anything narrower mis-frames the call.
# Blank = "Hello, you've reached {business}. How may I help you today?"
INBOUND_GREETING=

# ---- Runtime ----
# The poller's SAFETY interval, in seconds. The queue is normally driven by NOTIFICATIONS from the
# backend (set AGENT_NOTIFY_URL there), which wake the poller immediately; this is only the
# backstop for a notification lost to a restart or a blip. Keep it LONG — every cycle wakes the
# Neon compute, and a short drumbeat is what keeps the database billing around the clock. It must
# also stay comfortably longer than Neon's autosuspend, or the compute never suspends between
# polls and none of this saves anything.
POLL_INTERVAL_SECONDS=1800
# Port the poller's notification endpoint listens on (its own process, so its own port).
# Traefik routes https://<PUBLIC_HOST>/poller/* to it.
POLLER_PORT=5060
# Business timezone for spoken dates — keep in sync with the backend's SCHEDULE_TIMEZONE.
TIMEZONE=America/Los_Angeles
REQUEST_TIMEOUT_SECONDS=30
