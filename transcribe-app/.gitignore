# Any local env file - .env, .env.test, .env.whatever. Only the *.example templates are
# committed. This app gets deployed on its own, so it can't rely on the repo-root .gitignore.
.env
.env.*
!.env.example
!.env.test.example
.venv/
service-account.json
.processed.json
.processed.test.json
__pycache__/
*.pyc
