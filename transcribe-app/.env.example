# Copy to .env and fill in. Never commit .env or the service-account key.

# ---- Email (IMAP — any provider) ----
# The voicemail .wav files arrive as email attachments. This reads them over plain IMAP, so it
# works with whatever mailbox the customer uses — you just point it at the right host.
# Fastest path: set IMAP_PROVIDER and it fills in host/port for you. For testing we use
# outlook.com, so IMAP_PROVIDER=outlook.
#   Known providers: outlook, office365, gmail, yahoo, icloud, aol, zoho,
#                    comcast/xfinity (residential), comcastbiz/comcastbusiness (Comcast Business)
# For anything else, leave IMAP_PROVIDER blank and set IMAP_HOST/IMAP_PORT directly.
IMAP_PROVIDER=outlook
# IMAP_HOST=            # overrides the provider preset (e.g. mail.yourcompany.com)
# IMAP_PORT=993
# IMAP_SSL=true         # true = implicit TLS (993); false = STARTTLS
IMAP_USERNAME=
# Use an app password if the account has 2-factor auth (Outlook.com, Gmail, and Yahoo all
# require an app password for IMAP; their normal login password will be rejected).
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Only scan mail newer than this many days (0 = no limit). Keeps runs fast on big mailboxes.
IMAP_SINCE_DAYS=7
# Optional filters so we only look at voicemail mail. Leave blank to accept any message that
# has a .wav attachment. Set these to the sender / subject your voicemail-to-email uses.
# VOICEMAIL_FROM=voicemail@twilio.com
# VOICEMAIL_SUBJECT=New voicemail

# ---- Transcription + extraction (Google Gemini, one multimodal call) ----
# Gemini reads the .wav directly and returns the transcript plus the structured fields in a
# single call — no separate speech-to-text service needed.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# This is a Gemini Developer API key — separate from the Google Sheets service account below.
GEMINI_API_KEY=
EXTRACT_MODEL=gemini-2.5-flash-lite

# ---- Destination (Google Sheets, service account) ----
# Create a service account in Google Cloud, enable the Sheets API, and share the target sheet
# with the service account's email (…@….iam.gserviceaccount.com, the "client_email" in the
# key JSON) as an Editor. Then give the app the key ONE of these three ways:
#
# Option A — private key + email (leanest; two values, no file). Both come from the key JSON
# (the "private_key" and "client_email" fields). Wrap the key in single quotes and keep the
# \n sequences as-is — they're converted back to newlines at load.
#   GOOGLE_CLIENT_EMAIL=…@….iam.gserviceaccount.com
#   GOOGLE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n'
#
# Option B — the whole key JSON inline, on one line (single-quoted).
#   GOOGLE_CREDENTIALS_JSON='{"type":"service_account","private_key":"…","client_email":"…", …}'
#
# Option C — a path to the downloaded key file (simplest locally).
GOOGLE_CREDENTIALS_FILE=service-account.json
# The spreadsheet ID is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# The tab (and anchor cell) to append under. The tab must already exist.
SHEET_RANGE=Voicemails!A1

# ---- Access to the recording — we store NOTHING; the sheet links back to the source email ----
# EMAIL_LINK_TEMPLATE builds the "Open email" column: it opens the SOURCE message in webmail, so
# the person downloads the recording straight from the email (best for privacy — no copy is stored
# or served by us). Only works for people logged into that mailbox. Placeholders:
#   {message_id} / {uid} / {mailbox} / {gm_msgid}. Examples:
#     Gmail (opens directly):  https://mail.google.com/mail/u/0/#all/{gm_msgid}
#     Gmail (search fallback): https://mail.google.com/mail/u/0/#search/rfc822msgid:{message_id}
#     Roundcube:               https://mail.olympusspa.net/?_task=mail&_action=show&_mbox={mailbox}&_uid={uid}
EMAIL_LINK_TEMPLATE=https://mail.google.com/mail/u/0/#all/{gm_msgid}

# ---- Metrics reporting (optional — powers the dashboard's Transcriptions tab) ----
# After each run, POST the run's counts to <BACKEND_URL>/transcribe/runs. Leave BACKEND_URL blank
# to disable reporting. TRANSCRIBE_INGEST_KEY must match the backend's value (sent as a header).
BACKEND_URL=
TRANSCRIBE_INGEST_KEY=

# ---- Poller (scripts/run_poller.py — the always-on mode) ----
# How often the poller runs a pass, in seconds (default 300 = 5 min; floored to 30s). Already-seen
# voicemails are skipped each pass via the state file, so re-runs never create duplicates.
POLL_INTERVAL_SECONDS=300

# ---- Runtime ----
# Where processed voicemails are remembered so re-runs skip them (JSON; created automatically).
# STATE_FILE=.processed.json
REQUEST_TIMEOUT_SECONDS=60
