# Backend configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Bun auto-loads .env at startup (no dotenv needed).

# HTTP port the server listens on (default 8000)
PORT=8000

# development | production
NODE_ENV=development

# PostgreSQL connection string (required). Create the `intakes` table with `bun run db:migrate`.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#   - On Vercel (serverless): use the POOLED connection string from Vercel Postgres/Neon
#     (host contains "-pooler"), and keep ?sslmode=require. `prepare:false` (set in code)
#     makes it pooler-safe.
#   - Local dev on Windows: use 127.0.0.1 rather than "localhost" (Node resolves localhost
#     to IPv6 ::1 first, which Docker's IPv4 port mapping doesn't answer).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/backend

# Comma-separated list of browser origins allowed to call this API (the Vercel frontends),
# e.g. https://form.vercel.app,https://admin.vercel.app. Unset = allow any origin (dev only).
CORS_ORIGIN=

# --- Booking / schedule grid ---
# The bookable slot grid = business hours in this timezone, split into fixed-length slots.
# These are the single source of truth for availability (the voice agent uses them too),
# so keep them matching the business's real hours.
# IANA timezone the business hours are expressed in.
SCHEDULE_TIMEZONE=America/Los_Angeles
# Bookable weekdays, ISO numbering 1=Mon … 7=Sun.
SCHEDULE_WORKDAYS=1,2,3,4,5
# Business hours, "HH:MM" (24h). Slots run from START up to END.
SCHEDULE_START=08:00
SCHEDULE_END=17:00
# Slot length in minutes. Also the window used to detect double-booking conflicts.
SCHEDULE_SLOT_MINUTES=30

# --- Cal.com (meeting link only) ---
# The backend owns availability + the booking; Cal.com is used ONLY to create the meeting
# (calendar invite + join link, emailed to the attendee) when a booking is confirmed, and
# to cancel it when the booking is deleted — so a freed slot can be cleanly re-booked.
# Leave CAL_API_KEY blank to disable the Cal.com step entirely (bookings still work, just
# without a meeting link).
CAL_API_KEY=
# The Cal.com event type that carries the video/Teams config (a positive integer).
CAL_EVENT_ID=

# --- Agent tools (Retell custom functions) ---
# Shared secret the voice agent (Retell) sends as the `x-agent-secret` header when it
# calls the /agent/* tool endpoints (check-availability, openings, book). If set, those
# endpoints reject requests without a matching header. Leave blank in dev; set a strong
# random value in production and configure the same value on the Retell function headers.
AGENT_TOOLS_SECRET=

# --- Retell post-call webhook (retry / outcome handling) ---
# Retell POSTs call events to POST /retell/webhook. On a call that didn't connect we schedule
# a retry (up to RETELL_MAX_ATTEMPTS, spaced by RETELL_RETRY_DELAY_SECONDS), then mark the
# lead unreachable; a reached call is marked contacted so the poller stops calling. Keep
# RETELL_MAX_ATTEMPTS in sync with the poller's MAX_CALL_ATTEMPTS. The webhook is guarded by
# ?secret=<AGENT_TOOLS_SECRET> in its URL (the agent webhook can't send custom headers).
RETELL_RETRY_DELAY_SECONDS=60
RETELL_MAX_ATTEMPTS=3
