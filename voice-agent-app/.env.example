# Copy to .env and fill in. Never commit .env.

# The voice layer is Retell now — it owns telephony, speech-to-text, text-to-speech,
# turn-taking, and the conversational LLM. This app just polls the backend for leads and
# tells Retell to call them. (The old Hermes / Gemini / ElevenLabs / Twilio-call stack has
# been removed.)

# ---- This application ----
# Port this app listens on locally.
PORT=3000

# ---- Agent persona label (kept for the post-call email; optional) ----
AGENT_NAME=Tess
AGENT_ORG=TecAce

# ---- Backend API (leads, scheduling, status tracking) ----
# The shared backend the agent uses instead of Cal.com + Google Sheets: it reads new
# leads (GET /intake?status=new), checks availability + suggestions, books a chosen slot,
# and writes back status + the post-call summary. No trailing slash.
#   Local backend:  http://localhost:8000   (or http://127.0.0.1:8000 on Windows)
#   Deployed:       https://voice-agent-backend-cyan.vercel.app
BACKEND_URL=
# NOTE: Cal.com (meeting invite + join link) is now handled entirely by the backend, not
# the voice agent — set CAL_API_KEY / CAL_EVENT_ID on the backend, not here.

# ---- Retell (the voice agent that places the calls) ----
# Retell owns the voice layer now. The poller (scripts/run_retell_poller.py) triggers a
# Retell outbound call per new lead. Get the API key + agent id from the Retell dashboard;
# from_number is the Twilio number you IMPORTED into Retell (defaults to PHONE_NUMBER).
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# ---- Post-call email (CRM push; optional — off if unset) ----
# Team inbox that gets a summary after each call. SMTP works with Gmail using an
# app password (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# ---- Runtime ----
REQUEST_TIMEOUT_SECONDS=60
