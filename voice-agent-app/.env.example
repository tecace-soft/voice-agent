# Copy to .env and fill in. Never commit .env.

# ---- This application ----
# Port this app listens on locally.
PORT=3000

# ---- Hermes agent (self-hosted on Hostinger) ----
# Scheme, host and the Hermes port, e.g. http://203.0.113.10:32770
HERMES_SERVER_URL=
# Path prefix of the Hermes Agent API on that server.
HERMES_API_PATH=
# Cookie-session login for the Hermes Agent app (provider "basic").
HERMES_USERNAME=
HERMES_PASSWORD=
HERMES_AUTH_PROVIDER=
# Only used if the endpoint accepts a bearer token instead of a cookie.
HERMES_API_KEY=
HERMES_MODEL=

# ---- ElevenLabs (voice) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=
# Route the agent's generative replies (persona / FAQ) through Hermes, with a
# Gemini fallback. Set false to use Gemini only.
USE_HERMES_BRAIN=true

# ---- Agent persona (how it introduces itself + handles small talk / FAQs) ----
AGENT_NAME=Tess
AGENT_ORG=TecAce

# ---- Backend API (leads, scheduling, status tracking) ----
# The shared backend the agent uses instead of Cal.com + Google Sheets: it reads new
# leads (GET /intake?status=new), checks availability + suggestions, books a chosen slot,
# and writes back status + the post-call summary. No trailing slash.
#   Local backend:  http://localhost:8000   (or http://127.0.0.1:8000 on Windows)
#   Deployed:       https://voice-agent-backend-cyan.vercel.app
BACKEND_URL=

# ---- Cal.com (meeting link only) ----
# Used ONLY to create the consultation meeting (calendar invite + join link) when a booking
# is confirmed — the backend still owns availability + the booking. Configure the event
# type's video location (Teams/Zoom/Meet) and set its availability WIDE enough that it never
# rejects a time the backend already approved. Leave blank to skip meeting creation (the
# lead is still booked in the backend, just without an invite email).
CAL_API_KEY=
# The Cal.com event type the agent books (the one set up for the video meeting).
CAL_EVENT_TYPE_ID=

# ---- Post-call email (CRM push; optional — off if unset) ----
# Team inbox that gets a summary after each call. SMTP works with Gmail using an
# app password (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# ---- Twilio (phone calls) ----
PHONE_NUMBER=
ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public https base Twilio can reach (e.g. your ngrok URL). Needed for real
# calls so audio links resolve and outbound calls can be placed.
PUBLIC_BASE_URL=

# ---- Pending destination (local staging store) ----
PENDING_DB_PATH=./data/pending.sqlite

# ---- Runtime ----
REQUEST_TIMEOUT_SECONDS=60
