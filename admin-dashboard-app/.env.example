# Admin dashboard configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Base URL of the deployed backend API (no trailing slash), e.g. your Vercel backend:
# VITE_BACKEND_URL=https://voice-agent-backend-cyan.vercel.app
VITE_BACKEND_URL=http://localhost:8000
