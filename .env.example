# Copy to .env and fill in. Never commit .env.

# ---- This application ----
# Port this app listens on locally.
PORT=3000

# ---- Hermes agent (self-hosted on Hostinger) ----
# Scheme, host and the Hermes port, e.g. http://203.0.113.10:32770
HERMES_SERVER_URL=
# Path prefix of the Hermes Agent API on that server.
HERMES_API_PATH=
# Cookie-session login for the Hermes Agent app (provider "basic").
HERMES_USERNAME=
HERMES_PASSWORD=
HERMES_AUTH_PROVIDER=
# Only used if the endpoint accepts a bearer token instead of a cookie.
HERMES_API_KEY=
HERMES_MODEL=

# ---- ElevenLabs (voice) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ---- Google Forms (supplies the agent's questions; polled for submissions) ----
# Enable the Google Forms API in your Cloud project and share the form with
# GOOGLE_API_EMAIL (below). Auth reuses the Sheets service-account key.
# Accepts a raw form id or a full form URL.
GOOGLE_FORM_ID=

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Agent persona (how it introduces itself + handles small talk / FAQs) ----
AGENT_NAME=Tess
AGENT_ORG=TecAce

# ---- Google Sheets (track collected info; service account) ----
# Share the target sheet with GOOGLE_API_EMAIL as Editor.
GOOGLE_API_EMAIL=
# Service-account private key. PEM, or its base64 body (headers/newlines
# stripped, or with literal \n) — normalized automatically.
GOOGLE_API_SHEETS_KEY=
GOOGLE_SHEETS_ID=

# ---- Cal.com (scheduling) ----
CAL_API_KEY=
# The event type the agent books (from `python scripts/verify_cal.py`).
CAL_EVENT_TYPE_ID=

# ---- Twilio (phone calls) ----
PHONE_NUMBER=
ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public https base Twilio can reach (e.g. your ngrok URL). Needed for real
# calls so audio links resolve and outbound calls can be placed.
PUBLIC_BASE_URL=

# ---- Pending destination (local staging store) ----
PENDING_DB_PATH=./data/pending.sqlite

# ---- Runtime ----
REQUEST_TIMEOUT_SECONDS=60
