# Without this the log grows forever: ~8,600 sample blocks a day, one line per container each.
# Left alone it will eventually fill the disk and take the box down with it.
/var/log/docker-container-stats.log {
    daily
    rotate 7
    size 50M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
