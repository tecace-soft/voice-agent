# Transcribe-backend configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Bun auto-loads .env at startup (no dotenv needed).

# HTTP port the server listens on (default 8001 — the main backend uses 8000, so both run locally).
PORT=8001

# development | production
NODE_ENV=development

# PostgreSQL connection string (required). Owns the `voicemail_runs` table; create it with
# `bun run db:migrate`. This can be its OWN database, or point it at the main backend's database
# to keep any voicemail_runs data already recorded there.
#   - On Vercel (serverless): use the POOLED connection string (host contains "-pooler"), keep
#     ?sslmode=require. `prepare:false` (set in code) makes it pooler-safe.
#   - Local dev on Windows: use 127.0.0.1 rather than "localhost".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/transcribe

# Comma-separated browser origins allowed to call this API — the transcribe dashboard's origin,
# e.g. https://transcribe-dashboard-app.vercel.app (and http://localhost:5174 for local dev).
# Unset = allow any origin (dev only).
CORS_ORIGIN=

# IANA timezone used for the "today"/daily day boundaries in the stats.
BUSINESS_TIMEZONE=America/Los_Angeles

# How long after a period ends before its usage total is reported as settled (seconds). A call is
# only counted when it ends, so a call still running when the period closed arrives afterwards.
USAGE_SETTLE_SECONDS=3600

# Shared secret guarding the write endpoint. The transcribe-app must send this as the
# `x-transcribe-key` header on POST /transcribe/runs. Unset = open (dev only).
TRANSCRIBE_INGEST_KEY=

# ---- Monthly allowance ----
# Transcriptions included per calendar month, in the business timezone above. Past the warn point
# the dashboard shows a small meter on the "This month" card with how many are left and what the
# next one costs; below it, nothing about a cap is shown at all. 0 disables the whole thing.
TRANSCRIBE_MONTHLY_CAP=1500
# Fraction of the allowance at which the meter appears. 0.8 = 80%, i.e. from 1200 of 1500.
TRANSCRIBE_CAP_WARN_AT=0.8
# USD per transcript beyond the allowance, quoted verbatim to the customer. Update if pricing moves.
TRANSCRIBE_OVERAGE_RATE=0.15

# Secret that signs dashboard session tokens (REQUIRED in production, min 32 chars).
# Generate one with:  openssl rand -hex 32
# Changing it signs everyone out. Unset in development = a random per-process secret (sessions
# don't survive a restart).
AUTH_SECRET=

# How long a dashboard sign-in lasts, in hours (default 168 = 7 days).
AUTH_TOKEN_TTL_HOURS=168

# --- Optional bootstrap admin -------------------------------------------------------------------
# Creates an ADMIN account on the first request after a deploy, so someone can sign in before anyone
# opens the dashboard (handy on Vercel, where there's no shell to run `bun run auth create` in).
#
# - Only creates the account if that email doesn't already have one; it NEVER changes the password
#   of an existing account, so leaving these set can't reset you on every deploy.
# - If the account exists but isn't an admin, it is promoted.
# - Safe to delete both variables once the account exists.
# Change this password after your first sign-in: anyone who can read the project's env vars can see
# it here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional display name; defaults to the part of the email before the @.
SEED_ADMIN_NAME=

# ---- Demo test call ----
# The "Call now" panel on a prospect's Demo page dials the prospect's agent from the browser over
# OpenAI's live API. Same key and model names as openai-agent-app, so one value can serve both.
#
# Optional on purpose: with no key every other Demo route keeps working and only the dial is
# refused, with "OPENAI_API_KEY is not set on the server." Set it on Vercel to enable test calls —
# a test call spends real realtime minutes, and admin auth plus 5 calls/minute per IP are the only
# limits on it.
OPENAI_API_KEY=
# Override only to point at a proxy or a compatible endpoint; a trailing slash is trimmed for you.
OPENAI_BASE_URL=https://api.openai.com/v1
# The voice model that holds the conversation.
OPENAI_LIVE_MODEL=gpt-live-1
# The text model GPT-Live delegates tool calls to: gpt-5.6-terra (recommended) or gpt-5.6-luna
# (cheaper).
OPENAI_BACKEND_MODEL=gpt-5.6-terra
# Reads the finished transcript and writes the post-call review the Activity tab shows. A failed
# review is saved as no review, never as a failed call, so this is safe to leave on the default.
CALL_REVIEW_MODEL=gpt-5.6-terra
# Researching a new prospect's business: two calls to the same Responses API on the same
# OPENAI_API_KEY, the first of them with web search on. That is a real, billable run — with no key
# every other Demo route keeps working and only research is refused, with the same
# "OPENAI_API_KEY is not set on the server."
#
# Which provider runs it. Only `openai` is implemented in this backend; the promo's `cli` (the
# Claude Code CLI on the operator's machine) and `anthropic` branches are not carried, and setting
# either here fails a research attempt with a message saying so rather than silently doing nothing.
# Leave it blank for openai.
RESEARCH_PROVIDER=
# The model that does the researching and then reformats the briefing into the business profile.
RESEARCH_OPENAI_MODEL=gpt-5.6-terra
# How much the web search tool reads back: low | medium | high. Anything else (including blank) is
# medium. Higher costs more per run and is slower; the two passes share a 300s ceiling.
RESEARCH_SEARCH_CONTEXT=medium
# The agent is told today's date and the business's opening hours; this is the timezone used when
# the browser sends none, or sends something that isn't a real IANA zone.
DEFAULT_TIMEZONE=America/Los_Angeles
