# Transcribe-backend configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Bun auto-loads .env at startup (no dotenv needed).

# HTTP port the server listens on (default 8001 — the main backend uses 8000, so both run locally).
PORT=8001

# development | production
NODE_ENV=development

# PostgreSQL connection string (required). Owns the `voicemail_runs` table; create it with
# `bun run db:migrate`. This can be its OWN database, or point it at the main backend's database
# to keep any voicemail_runs data already recorded there.
#   - On Vercel (serverless): use the POOLED connection string (host contains "-pooler"), keep
#     ?sslmode=require. `prepare:false` (set in code) makes it pooler-safe.
#   - Local dev on Windows: use 127.0.0.1 rather than "localhost".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/transcribe

# Comma-separated browser origins allowed to call this API — the transcribe dashboard's origin,
# e.g. https://transcribe-dashboard-app.vercel.app (and http://localhost:5174 for local dev).
# Unset = allow any origin (dev only).
CORS_ORIGIN=

# IANA timezone used for the "today"/daily day boundaries in the stats.
BUSINESS_TIMEZONE=America/Los_Angeles

# Shared secret guarding the write endpoint. The transcribe-app must send this as the
# `x-transcribe-key` header on POST /transcribe/runs. Unset = open (dev only).
TRANSCRIBE_INGEST_KEY=
