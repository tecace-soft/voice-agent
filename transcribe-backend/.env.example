# Transcribe-backend configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Bun auto-loads .env at startup (no dotenv needed).

# HTTP port the server listens on (default 8001 — the main backend uses 8000, so both run locally).
PORT=8001

# development | production
NODE_ENV=development

# PostgreSQL connection string (required). Owns the `voicemail_runs` table; create it with
# `bun run db:migrate`. This can be its OWN database, or point it at the main backend's database
# to keep any voicemail_runs data already recorded there.
#   - On Vercel (serverless): use the POOLED connection string (host contains "-pooler"), keep
#     ?sslmode=require. `prepare:false` (set in code) makes it pooler-safe.
#   - Local dev on Windows: use 127.0.0.1 rather than "localhost".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/transcribe

# Comma-separated browser origins allowed to call this API — the transcribe dashboard's origin,
# e.g. https://transcribe-dashboard-app.vercel.app (and http://localhost:5174 for local dev).
# Unset = allow any origin (dev only).
CORS_ORIGIN=

# IANA timezone used for the "today"/daily day boundaries in the stats.
BUSINESS_TIMEZONE=America/Los_Angeles

# How long after a period ends before its usage total is reported as settled (seconds). A call is
# only counted when it ends, so a call still running when the period closed arrives afterwards.
USAGE_SETTLE_SECONDS=3600

# Shared secret guarding the write endpoint. The transcribe-app must send this as the
# `x-transcribe-key` header on POST /transcribe/runs. Unset = open (dev only).
TRANSCRIBE_INGEST_KEY=

# ---- Monthly allowance ----
# Transcriptions included per calendar month, in the business timezone above. Past the warn point
# the dashboard shows a small meter on the "This month" card with how many are left and what the
# next one costs; below it, nothing about a cap is shown at all. 0 disables the whole thing.
TRANSCRIBE_MONTHLY_CAP=1500
# Fraction of the allowance at which the meter appears. 0.8 = 80%, i.e. from 1200 of 1500.
TRANSCRIBE_CAP_WARN_AT=0.8
# USD per transcript beyond the allowance, quoted verbatim to the customer. Update if pricing moves.
TRANSCRIBE_OVERAGE_RATE=0.15

# Secret that signs dashboard session tokens (REQUIRED in production, min 32 chars).
# Generate one with:  openssl rand -hex 32
# Changing it signs everyone out. Unset in development = a random per-process secret (sessions
# don't survive a restart).
AUTH_SECRET=

# How long a dashboard sign-in lasts, in hours (default 168 = 7 days).
AUTH_TOKEN_TTL_HOURS=168

# --- Optional bootstrap admin -------------------------------------------------------------------
# Creates an ADMIN account on the first request after a deploy, so someone can sign in before anyone
# opens the dashboard (handy on Vercel, where there's no shell to run `bun run auth create` in).
#
# - Only creates the account if that email doesn't already have one; it NEVER changes the password
#   of an existing account, so leaving these set can't reset you on every deploy.
# - If the account exists but isn't an admin, it is promoted.
# - Safe to delete both variables once the account exists.
# Change this password after your first sign-in: anyone who can read the project's env vars can see
# it here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional display name; defaults to the part of the email before the @.
SEED_ADMIN_NAME=

# ---- Demo test call ----
# The "Call now" panel on a prospect's Demo page dials the prospect's agent from the browser over
# OpenAI's live API. Same key and model names as openai-agent-app, so one value can serve both.
#
# Optional on purpose: with no key every other Demo route keeps working and only the dial is
# refused, with "OPENAI_API_KEY is not set on the server." Set it on Vercel to enable test calls —
# a test call spends real realtime minutes, and admin auth plus 5 calls/minute per IP are the only
# limits on it.
OPENAI_API_KEY=
# Override only to point at a proxy or a compatible endpoint; a trailing slash is trimmed for you.
OPENAI_BASE_URL=https://api.openai.com/v1
# The voice model that holds the conversation.
OPENAI_LIVE_MODEL=gpt-live-1
# The text model GPT-Live delegates tool calls to: gpt-5.6-terra (recommended) or gpt-5.6-luna
# (cheaper).
OPENAI_BACKEND_MODEL=gpt-5.6-terra
# Reads the finished transcript and writes the post-call review the Activity tab shows. A failed
# review is saved as no review, never as a failed call, so this is safe to leave on the default.
# Default gpt-5.6-luna (cheaper); gpt-5.6-terra for a closer read.
CALL_REVIEW_MODEL=gpt-5.6-luna
# Researching a new prospect's business: two calls to the same Responses API on the same
# OPENAI_API_KEY, the first of them with web search on. That is a real, billable run — with no key
# every other Demo route keeps working and only research is refused, with the same
# "OPENAI_API_KEY is not set on the server."
#
# Which provider runs it. Only `openai` is implemented in this backend; the promo's `cli` (the
# Claude Code CLI on the operator's machine) and `anthropic` branches are not carried, and setting
# either here fails a research attempt with a message saying so rather than silently doing nothing.
# Leave it blank for openai.
RESEARCH_PROVIDER=
# The model that does the researching and then reformats the briefing into the business profile.
# Default gpt-5.6-luna (cheaper); gpt-5.6-terra for deeper research.
RESEARCH_OPENAI_MODEL=gpt-5.6-luna
# How much the web search tool reads back: low | medium | high. Anything else (including blank) is
# medium. Higher costs more per run and is slower; the two passes share a 300s ceiling.
RESEARCH_SEARCH_CONTEXT=medium

# ---- Guided setup interview ----
# The "Set up with a consultant" chat on the Business page: one model call per message plus a tool
# call per setting it writes, on the same OPENAI_API_KEY. Writes only the call-settings draft.
# What it writes reaches live calls only when openai-agent-app runs the composed GPT-Live session
# (OPENAI_LIVE_MODEL set there); on the Realtime bridge the published scenarios are ignored on the phone.
SETUP_ASSISTANT_MODEL=gpt-5.6-luna
# Messages one setup conversation may hold before it has to be reset.
SETUP_MAX_TURNS=80
# Messages one account may send per day across conversations (admins exempt). 0 = no cap.
SETUP_DAILY_TURN_CAP=150

# The agent is told today's date and the business's opening hours; this is the timezone used when
# the browser sends none, or sends something that isn't a real IANA zone.
DEFAULT_TIMEZONE=America/Los_Angeles

# ---- Calendar connections (Appointments) ----
# The Appointments section lets a business connect where the assistant books callers. Apple
# (iCloud, Apple ID + app-specific password), any other CalDAV calendar, Cal.com (API key),
# Calendly (personal access token) and Squarespace Scheduling / Acuity (User ID + API key) need
# nothing here. Google Calendar and Outlook sign in with OAuth and each needs an app registered
# with the provider; until one is set, that provider shows as "Needs setup".
#
# Encrypts the stored calendar credentials (AES-256-GCM). Falls back to AUTH_SECRET. Adding it later
# is safe: connections saved under AUTH_SECRET still open, and move to this key the first time
# they're read. Changing it once set makes stored connections unreadable: they then ask to be
# reconnected.
CALENDAR_SECRET=
# This backend's public origin, used to build the OAuth redirect URIs. Unset = taken from the
# request. Register these redirect URIs with Google / Microsoft:
#   <PUBLIC_BACKEND_URL>/calendar/oauth/google/callback
#   <PUBLIC_BACKEND_URL>/calendar/oauth/microsoft/callback
PUBLIC_BACKEND_URL=
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Enable the Google Calendar API. Scopes used: openid, email, calendar.readonly, calendar.events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra admin center → App registrations → New registration (any org + personal
# accounts), Web redirect URI as above, a client secret, and the delegated Graph permissions
# offline_access, User.Read, Calendars.ReadWrite.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = work/school and personal accounts. Set a tenant id to restrict to one organisation.
MICROSOFT_TENANT=common

# ---- Email and sign-up ----
# Sign-up codes, password resets, sign-in links, "you can edit now", and the admin's new-request
# notice. Same names as backend-app (a Gmail App Password works). With no SMTP_HOST/USERNAME/PASSWORD
# nothing is sent: a claim from a demo page waits for an admin as a request, /start sign-up is closed,
# and sign-in links are copied by hand from the admin screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME (Gmail requires From = the signed-in account).
SMTP_FROM=
# The dashboard's public origin; every link in an email is built from this, never from a request.
DASHBOARD_URL=
# Who hears about new sign-ups and setup requests. Unset = no email; the sidebar badge still shows.
ADMIN_NOTIFY_EMAIL=
# Research runs self-service sign-ups may start per day in total (each is two billable model calls).
SIGNUP_RESEARCH_DAILY_CAP=30

# ---- Twilio (agent phone numbers) ----
# The Twilio account the agent's numbers live in — the same one openai-agent-app uses. With these set,
# the Agent numbers page can sync the account's numbers, search and buy new ones (local or toll-free),
# set each number's webhooks and release numbers (phase 1); forwarding tests and status callbacks
# follow (phase 2). Unset = those actions answer "Twilio isn't set up on this server"; registering
# numbers by hand and assigning them still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Or an API key instead of the auth token for the REST calls (Twilio console → API keys; a restricted
# key needs phone numbers read + write). Used when both are set. Signature checks (phase 2) still need
# TWILIO_AUTH_TOKEN.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The phone agent's public origin (openai-agent-app on the VPS). Every managed number gets
# VoiceUrl=<this>/incoming and VoiceFallbackUrl=<this>/incoming-fallback.
AGENT_PUBLIC_URL=https://31-97-214-59.sslip.io
# Each number's StatusCallback is <PUBLIC_BACKEND_URL (above)>/twilio/voice-status. Unset, it falls back to
# https://<VERCEL_PROJECT_PRODUCTION_URL> (set by Vercel), so production needs nothing here; locally, set it.
# Every request Twilio sends there is checked against a signature over that exact URL — so it must be
# the origin Twilio actually calls (the custom domain, not the *.vercel.app alias, if both exist).
# Phase 2: set to false only to curl /twilio/* locally; those routes then trust anyone who can reach them.
TWILIO_VALIDATE_SIGNATURE=true
# Phase 2: how long a forwarding test lets the business's own line ring (10–120). Longer than the
# carrier's no-answer forwarding delay (20–30s), or a customer forwarding only missed calls reads as
# "not forwarded".
FORWARDING_TEST_TIMEOUT_SECONDS=40
# Optional: send texts through a Messaging Service instead of the business's own number (not used yet).
TWILIO_MESSAGING_SERVICE_SID=

# Scenario tests (admin only). The runner is the `scenarios` service in openai-agent-app.
# SCENARIO_RUNNER_URL is its public base, e.g. https://31-97-214-59.sslip.io/scenarios
# SCENARIO_RUNNER_KEY must equal the runner's SCENARIO_RUNNER_KEY.
SCENARIO_RUNNER_URL=
SCENARIO_RUNNER_KEY=
# The model that grades each run. Default gpt-5.6-luna.
SCENARIO_JUDGE_MODEL=gpt-5.6-luna
