{
  "name": "transcribe-backend",
  "version": "0.1.0",
  "description": "Transcribe-metrics backend (Elysia; Bun locally, Vercel/Node in prod) for the transcribe-app + transcribe-dashboard-app.",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "db:migrate": "bun run src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.29",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "5"
  }
}
