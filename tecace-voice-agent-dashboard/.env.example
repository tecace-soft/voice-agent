# TecAce voice agent dashboard configuration (template).
# Copy to .env and fill in per machine — .env is git-ignored and does not travel with `git pull`.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Base URL of transcribe-backend (no trailing slash). It serves sign-in, /transcribe/*, /business/*,
# /calls, /usage/*, /feedback, /api-keys and /demo/* — everything every screen reads, Demo included.
BACKEND_URL=http://localhost:8001

# The promo's public origin (no trailing slash). Prospect demo links (/c/<id>) that the Prospects
# and Share screens copy and email point here — the promo serves that page itself. Required for a
# real build; `npm run build` warns when it is unset.
VITE_PUBLIC_DEMO_BASE_URL=http://localhost:3000
# Optional: contact links shown on the promo's public demo page. Defaults are TecAce's.
# VITE_CONTACT_URL=
# VITE_PRICING_URL=
# VITE_CONTACT_EMAIL=
